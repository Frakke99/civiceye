# Kopieer naar .env en vul in. .env staat in .gitignore.
# Alles met EXPO_PUBLIC_ zit in de app-bundle en is publiek — dat is de bedoeling
# voor deze drie. Zet hier NOOIT de service_role-key.

EXPO_PUBLIC_SUPABASE_URL=https://jouw-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
EXPO_PUBLIC_ENV=dev

# Optioneel. Zonder key werkt de app, maar zonder kaartachtergrond.
# Gratis key op maptiler.com
EXPO_PUBLIC_MAPTILER_KEY=
